# Formadagi arizalar shu Telegram botiga yuboriladi: @Kokand_Dry_Fruits_Bot
#
# 1) @BotFather -> token
TELEGRAM_BOT_TOKEN=

# 2) Botga /id yozing -> qaytgan raqamni shu yerga qo'ying.
#    BIR NECHTA EGA: vergul bilan sanang, hammasiga bir vaqtda boradi.
#      TELEGRAM_CHAT_ID=123456789,987654321
#    Guruh id si manfiy bo'ladi: -1001234567890
#    Bo'sh bo'lsa faqat serverdagi logga yoziladi.
TELEGRAM_CHAT_ID=

# 3) Uzun tasodifiy satr. setWebhook da ham shu qiymat beriladi —
#    webhook'ga faqat Telegram murojaat qila olishi uchun.
#    Yaratish: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
#
#    DIQQAT: bu qiymat Vercel'dagi env bilan BIR XIL bo'lishi shart va
#    setWebhook faqat prod deploy yangilangandan KEYIN chaqiriladi —
#    aks holda Telegram 401 oladi va bot jim qoladi.
TELEGRAM_WEBHOOK_SECRET=

# 4) Saytning kanonik manzili — sitemap.xml, robots.txt, xreflang va JSON-LD
#    shu qiymatdan quriladi. Oxirida "/" bo'lmasin.
#    Prod: https://www.kdryfruits.com
NEXT_PUBLIC_SITE_URL=https://www.kdryfruits.com

# 5) Google Search Console tasdiqlash kodi (ixtiyoriy).
#    DNS TXT orqali tasdiqlash afzal — u butun domenni qamrab oladi.
#    Registrarga kirish bo'lmasa: GSC -> URL prefix -> HTML tag -> content=
#    qiymatini shu yerga qo'ying (faqat kodning o'zi, teg emas).
GOOGLE_SITE_VERIFICATION=
